# This repo's own dev .gitignore, for the Python/YAML tooling and
# tests that live here. Not to be confused with central-gitignore.txt,
# the distributable FORBIDDEN-pattern policy that the hooks/actions
# read as data (see README) — that one is a separate file on purpose,
# so this repo's own git plumbing never depends on the policy content
# it ships to other repos.

# --- Python ---
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
.eggs/
build/
dist/
.Python
.venv/
venv/
env/
ENV/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.ipynb_checkpoints/

# --- OS generated files ---
.DS_Store
Thumbs.db
Desktop.ini

# --- IDE / Editor settings ---
.vscode/
.idea/
*.code-workspace
*.swp
